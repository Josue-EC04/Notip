# ─── Anthropic Claude API ───────────────────────────────────────────────────
# Solo necesaria para desarrollo/pruebas locales sin Edge Function
# En producción, esta clave vive en las variables de entorno de Supabase Edge Functions
ANTHROPIC_API_KEY=tu_clave_anthropic_aqui

# ─── Supabase (v2 — login y nube) ────────────────────────────────────────────
# Obten estos valores en: https://app.supabase.com/project/TU_PROYECTO/settings/api
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui

# ─── Google OAuth (configurado en Supabase, no aquí directamente) ────────────
# El Client ID y Client Secret de Google van en Supabase Dashboard:
# Authentication → Providers → Google
# No pongas esas claves aquí.
