{
  "name": "notip",
  "version": "1.0.0",
  "description": "Tu segundo cerebro personal — mascota flotante con IA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "preview": "node scripts/preview.cjs",
    "test": "node --test tests/study.test.cjs",
    "test:ui": "node tests/run-ui.cjs",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "shortcut": "node scratch/build_clean_icon.js",
    "build:icon": "node scratch/build_clean_icon.js"
  },
  "build": {
    "appId": "com.notip.app",
    "productName": "Notip",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!scratch",
      "!tests",
      "!scripts",
      "!docs",
      "!vault/*",
      "!.git",
      "!.env"
    ],
    "extraResources": [
      {
        "from": "src/utils/checkFullscreen.ps1",
        "to": "checkFullscreen.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notip",
      "runAfterFinish": true
    }
  },
  "keywords": [
    "electron",
    "notes",
    "ai",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.116.0",
    "3d-force-graph": "^1.80.0",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "googleapis": "^178.1.1",
    "gray-matter": "^4.0.3",
    "sql.js": "^1.14.2",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
